<?xml version="1.0"?>
<!--
  tb3_sandbox plus one flat slab across the lane.

  A robot spawned at (-2.0, -0.5) facing +x meets it head-on after about 1 m.
  This is the original `stuck` scene; `tb3_corner`, `tb3_gap` and `tb3_wall_dim`
  vary the obstacle around it so the class rests on more than one situation.
-->
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="headless" default="true"/>
  <!-- relative includes resolve against this file's directory, not the cwd -->
  <xacro:include filename="tb3_base.xacro"/>

  <world name="default">
    <xacro:tb3_base_world headless="$(arg headless)"/>
    <xacro:slab name="stall_wall" x="-0.85" y="-0.5"/>
  </world>
</sdf>
