# Rollout bags are large (25–60 MB each) and fully regenerable from the
# scenario JSON via harness/recorder/record.py. Keyframes, manifests and events
# are kept — they are the actual inputs to evaluation and are small.
p*/data/*/bag/
p*/data/*/logs/

__pycache__/
*.pyc
.venv/

# DriveLM: 193 MB QA file + 3.5 GB of nuScenes images. The QA file is
# CC BY-NC-SA and re-fetchable; the images carry nuScenes' non-commercial
# terms and must not be redistributed from here.
p3-drivelm-eval/data/drivelm/
p3-drivelm-eval/data/*/pairs/
